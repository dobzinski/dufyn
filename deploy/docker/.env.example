# Copy to .env before starting a new installation. Never commit real credentials.

# Existing deployments must retain their existing values, including PKI_MASTER_KEY.
POSTGRES_DB=dufyn
POSTGRES_USER=dufyn
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Restricted application account, created by control.sh at startup.
# Never reuse the administrator name/password. Replace this placeholder before startup.
POSTGRES_APP_USER=dufyn_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_SEPARATE_RANDOM_PASSWORD

# Shared encryption key for private certificate keys and stored passwords.
# Generate once: openssl rand -base64 32
PKI_MASTER_KEY=REPLACE_WITH_A_PERSISTENT_RANDOM_KEY

# Manager credentials, required when access.login is true.
MANAGER_LOGIN_USER=admin
MANAGER_LOGIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Optional scanner overrides; blank values preserve current defaults/configuration.
SCANNER_TOKEN=
DNS_TSIG_SECRET=
SCANNER_MODE=

# Memory limits; tune for inventory size and concurrent operations.
MANAGER_MEMORY_LIMIT=1g
CONTROLLER_MEMORY_LIMIT=512m

# Release image tag. Never reuse a published tag for different image contents.
#DUFYN_IMAGE_TAG=latest
DUFYN_MANAGER_IMAGE_TAG=0.1.0
DUFYN_CONTROLLER_IMAGE_TAG=0.1.0
DUFYN_SCANNER_IMAGE_TAG=0.1.0
DUFYN_DATABASE_IMAGE_TAG=0.1.0

# Host interface for published ports: Manager 8080 and Controller 8081.
# 127.0.0.1 allows access from this host only (or through a host reverse proxy).
# For direct remote access, use the host's interface IP or 0.0.0.0 (all IPv4 interfaces).
# Remote scanners also need a reachable Controller URL in scanner/config.yaml.
MANAGER_BIND_ADDRESS=127.0.0.1
CONTROLLER_BIND_ADDRESS=127.0.0.1

# Trust forwarding headers only from actual reverse proxy peer IP(s), comma-separated.
# This does not control port access. Match the proxy address as seen by the app.
# Do not use '*'. Without a proxy, keep this default.
FORWARDED_ALLOW_IPS=127.0.0.1

# Network configuration examples
# Edit the active settings above to match one scenario; these examples are comments.
# BIND_ADDRESS selects a local interface on the Docker host, not a client/proxy IP.
# FORWARDED_ALLOW_IPS lists trusted reverse proxies, not scanner or browser IPs.
# This shared setting applies to both Manager and Controller.
#
# 1. Local access only, without a reverse proxy (default).
# MANAGER_BIND_ADDRESS=127.0.0.1
# CONTROLLER_BIND_ADDRESS=127.0.0.1
# FORWARDED_ALLOW_IPS=127.0.0.1
#
# 2. Direct remote access to Docker host 10.1.1.10, without a reverse proxy.
# Manager: http://10.1.1.10:8080; Controller: http://10.1.1.10:8081.
# A remote scanner (for example, 10.1.2.20) uses the Controller URL above.
# MANAGER_BIND_ADDRESS=10.1.1.10
# CONTROLLER_BIND_ADDRESS=10.1.1.10
# FORWARDED_ALLOW_IPS=127.0.0.1
# Use 0.0.0.0 instead of 10.1.1.10 to publish on all host IPv4 interfaces.
# To keep Manager local while allowing remote scanners, leave its bind at 127.0.0.1.
#
# 3. Remote reverse proxies forwarding to Docker host 10.1.1.10.
# Scanner 192.168.1.50 -> proxy 10.1.2.20 -> Controller 10.1.1.10:8081.
# Scanner 192.168.1.40 -> proxy 10.1.3.40 -> Controller 10.1.1.10:8081.
# MANAGER_BIND_ADDRESS=10.1.1.10
# CONTROLLER_BIND_ADDRESS=10.1.1.10
# FORWARDED_ALLOW_IPS=10.1.2.20,10.1.3.40
# Scanners use the reachable proxy URL in scanner/config.yaml.
# Proxies must set forwarding headers correctly and sanitize client-supplied values.
# If NAT changes the source IP, trust the proxy peer address seen by the app.
# Use firewall rules to restrict published ports to the intended peers.
#
# 4. Reverse proxy running directly on the Docker host.
# MANAGER_BIND_ADDRESS=127.0.0.1
# CONTROLLER_BIND_ADDRESS=127.0.0.1
# Set FORWARDED_ALLOW_IPS to the proxy peer IP actually seen inside the containers.
# Docker networking may present a gateway IP instead of 127.0.0.1.
# A proxy in another container needs reachable container networking; its own
# 127.0.0.1 does not point to the Docker host or the Dufyn containers.
